[Unit]
Description=Shanghai SDR Realtime Monitor
After=network-online.target
Wants=network-online.target

[Service]
# 按实际运行账号和仓库绝对路径修改 User / WorkingDirectory / ExecStart
Type=simple
User=root
WorkingDirectory=/opt/shanghai-sdr
Environment=SDR_URL=http://sdr.bh4dts.site:8073/status
Environment=INTERVAL=1
Environment=SAMPLE_EVERY=60
Environment=TIMEOUT=5
# Environment=WEBHOOK_URL=https://your-webhook.example.com/hook
ExecStart=/usr/bin/python3 scripts/monitor.py
Restart=always
RestartSec=3
# 日志由脚本写入 data/monitor.log，也可 journalctl -u sdr-monitor 查看
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
